tive","format":"JPEG Thumb","original":"screenshot_06.png","mtime":"1652040316","size":"5737","md5":"91ca8c3df5f43108d783e3aaaf5ac509","crc32":"9b545040","sha1":"259a8f1f8263cc39e3a11a770582d002433b1925"},{"name":"screenshot_07.png","source":"original","mtime":"1652040217","size":"3723","md5":"7d5d1a03addcfaeb88ae6dcc5bf2c10b","crc32":"2c2003b3","sha1":"8b09d21b6bf9e03e20919bb88069edf1ffe8082f","format":"PNG"},{"name":"screenshot_07_thumb.jpg","source":"derivative","format":"JPEG Thumb","original":"screenshot_07.png","mtime":"1652040319","size":"5713","md5":"15095c17e38a6dbb518da5ec380fe1f4","crc32":"bfdb1603","sha1":"658c50cf92632017ad5f108e5e7117e844a668cd"},{"name":"screenshot_08.png","source":"original","mtime":"1652040219","size":"3723","md5":"c1bb667eb17f85b0deb6641716827a0a","crc32":"a0b03004","sha1":"6520d218260d24af51caa931635ad50b88896e24","format":"PNG"},{"name":"screenshot_08_thumb.jpg","source":"derivative","format":"JPEG Thumb","original":"screenshot_08.png","mtime":"1652040323","size":"5725","md5":"f94bbbd25e16cf7afd54b313414573ea","crc32":"109db499","sha1":"b6cd0d99489b9cf2e09adb32f58c7cf3b8ea23ea"}],"files_count":27,"item_last_updated":1727821892,"item_size":203797,"metadata":{"identifier":"atari_2600_meltdown_atom_smasher_1983_20th_century_fox_video_games_-_videa_david_","collection":["atari_2600_library","consolelivingroom","stream_only","emulation"],"mediatype":"software","scanner":"Internet Archive Python library 0.4.8","title":"Atari 2600: Meltdown","publicdate":"2013-12-25 11:12:28","uploader":"softwarelibrary@textfiles.com","addeddate":"2013-12-25 11:12:28","emulator":"a2600","emulator_ext":"bin","emulator_instructions":"The Atari 2600 looks like <a href=\"https://archive.org/download/atari_2600_library/atari2600.jpg\">this</a>. The 1 key pushes the SELECT switch, and the 2 key pushes the RESET switch. Use the arrow keys to move Up/Down/Left/Right with the Joystick. Pressing the left CTRL button or space bar will press the fire button. Pressing the C key will switch between COLOR and B&W.","controller":"joystick","description":"This 1990 title is a unique light gun game that combines the paranoia of the cold war, the vibe of the Atari 2600 game <i>Reactor</i>, and the inaccuracy of a carnival gun into one cartridge. Defending twenty nuclear reactors from sabotage, you blast flying sparks trying to shatter cooling rods that keep a nuclear meltdown at bay. This daunting task is made a little bit easier by the fact that it is possible for the sparks to bounce off of your misses, adding a nice twist to the gameplay. There is a satisfying selection of power-ups too: Big Shots, Continuous Fire, Expand the Reactor, Double Points, etc.","backup_location":"ia905801_29","access-restricted-item":"true"},"server":"ia801403.us.archive.org","uniq":1472857747,"workable_servers":["ia801403.us.archive.org","ia601403.us.archive.org"]}
