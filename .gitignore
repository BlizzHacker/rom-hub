__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Runtime data. Plugins are cloned here and var/ holds state -- both grow, and
# neither belongs on the workstation drive or in the repo.
plugins/
var/

# The plugin is its own git repo (the live fixture inits it); do not treat it
# as content of this repo.
plugins-dev/*/.git/
